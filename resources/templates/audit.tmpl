<section class="legacy-workspace" id="audit" aria-labelledby="audit_title">
  <header class="legacy-workspace-header">
    <div>
      <p class="legacy-workspace-eyebrow">History</p>
      <h1 id="audit_title">Audit operations</h1>
      <p>Review topology changes and administrative operations recorded by Orchestrator.</p>
    </div>
  </header>
  <article class="legacy-panel">
    <div class="legacy-toolbar">
      <p>Most recent operations appear first.</p>
      <ul class="pager" aria-label="Audit operation pages">
        <li class="previous small"><a href="#" aria-label="Previous page">← Previous</a></li>
        <li class="next small"><a href="#" aria-label="Next page">Next →</a></li>
      </ul>
    </div>
    <div id="audit_empty" class="legacy-state" role="status">
      <h2>No audit operations recorded</h2>
      <p>Topology changes and administrative actions will appear here when audit persistence is enabled.</p>
    </div>
    <div id="audit_unavailable" class="legacy-state legacy-state--error" role="alert" style="display:none">
      <h2>Audit history is unavailable</h2>
      <p>Orchestrator could not load the audit operation history.</p>
    </div>
    <div id="audit_table_container" class="legacy-table-shell" style="display:none">
      <table class="table table-striped table-condensed">
        <thead><tr><th>Audit time</th><th>Type</th><th>Instance</th><th>Message</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </article>
</section>

<script>
  function currentPage() { return parseInt("{{.page}}"); }
  function auditHostname() { return "{{.auditHostname}}"; }
  function auditPort() { return parseInt("{{.auditPort}}"); }
</script>
<script src="{{.prefix}}/js/audit.js?v={{.assetVersion}}"></script>
