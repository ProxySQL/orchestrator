<link href="{{.prefix}}/css/cluster-workspace.css?v={{.assetVersion}}" rel="stylesheet">

<div id="cluster_workspace">
	<header class="cluster-workspace-header" aria-label="Cluster overview">
		<div id="cluster_name_info">
			<div id="cluster_name" class="text-muted"></div>
			<div id="cluster_subtitle"></div>
			<div id="cluster_info"></div>
		</div>
		<div id="cluster_live_status" role="status" aria-live="polite" aria-atomic="true" aria-label="Topology status"></div>
		<aside id="cluster_sidebar" class="cluster-view-menu dropdown" aria-label="Cluster display controls">
			<button class="cluster-view-toggle dropdown-toggle" type="button" id="cluster_view_toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-controls="cluster_view_menu">View</button>
			<ul id="cluster_view_menu" class="dropdown-menu dropdown-menu-end" aria-labelledby="cluster_view_toggle">
				<li data-bullet="info">
					<div>
						<a class="dropdown-item" href="#" data-command="info"><i class="bi bi-info-circle" aria-hidden="true"></i>Cluster information</a>
					</div>
				</li>
				<li data-bullet="colorize-dc">
					<div>
						<a class="dropdown-item" href="#" data-command="colorize-dc"><i class="bi bi-circle-half" aria-hidden="true"></i>Color by data center</a>
					</div>
				</li>
				<li data-bullet="compact-display">
					<div>
						<a class="dropdown-item" href="#" data-command="compact-display"><i class="bi bi-arrows-collapse" aria-hidden="true"></i>Compact display</a>
					</div>
				</li>
				<li data-bullet="pool-indicator">
					<div>
						<a class="dropdown-item" href="#" data-command="pool-indicator"><i class="bi bi-droplet-fill" aria-hidden="true"></i>Pool indicator</a>
					</div>
				</li>
				<li data-bullet="anonymize">
					<div>
						<a class="dropdown-item" href="#" data-command="anonymize"><i class="bi bi-person" aria-hidden="true"></i>Anonymize display</a>
					</div>
				</li>
				<li data-bullet="alias">
					<div>
						<a class="dropdown-item" href="#" data-command="alias"><i class="bi bi-tag" aria-hidden="true"></i>Instance aliases</a>
					</div>
				</li>
				<li data-bullet="silent-ui">
					<div>
						<a class="dropdown-item" href="#" data-command="silent-ui"><i class="bi bi-volume-mute" aria-hidden="true"></i>Silent interface</a>
					</div>
				</li>
			</ul>
		</aside>
	</header>

	<main id="cluster_canvas" aria-label="Cluster topology">
		<div id="cluster_wrapper">
			<div id="cluster_container" class="cluster-graph">
			</div>
			<div id="cluster_legend"></div>
		</div>
	</main>
</div>

<li id="li-move-instance-method" data-nav-page="relocate method" style="display:none">
	<div id="move-instance-method" class="dropdown">
		<button class="btn btn-xs dropdown-toggle" type="button" id="move-instance-method-button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
			Move
			<span class="caret"></span>
		</button>
		<ul class="dropdown-menu" aria-labelledby="move-instance-method">
			<li><a href="#" data-method="smart" title="Let orchestrator choose replica relocating method">Smart mode</a></li>
			<li><a href="#" data-method="classic" title="Move replicas using classic binlog file name and position">Classic mode</a></li>
			<li><a href="#" data-method="gtid" title="Move replicas via GTID">GTID mode</a></li>
			<li><a href="#" data-method="pseudo-gtid" title="Move replicas via Pseudo-GTID match of binary logs">Pseudo GTID mode</a></li>
		</ul>
	</div>
</li>

<script>
	function currentClusterName() {
		return "{{.clusterName}}";
	}

	function isPseudoGTIDModeEnabled() {
		return "{{.pseudoGTIDModeEnabled}}" == "true";
	}

	function removeTextFromHostnameDisplay() {
		return "{{.removeTextFromHostnameDisplay}}";
	}
</script>

<script src="{{.prefix}}/js/jquery-ui.min.js?v={{.assetVersion}}"></script>
<script src="{{.prefix}}/js/d3.v3.min.js?v={{.assetVersion}}"></script>
<script src="{{.prefix}}/js/cluster-analysis-shared.js?v={{.assetVersion}}"></script>
<script src="{{.prefix}}/js/cluster.js?v={{.assetVersion}}"></script>
<script src="{{.prefix}}/js/cluster-tree.js?v={{.assetVersion}}"></script>
