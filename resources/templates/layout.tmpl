<!doctype html>
<html>

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="">
	<meta name="author" content="">
	<link rel="shortcut icon" href="/images/orchestrator-logo-32-dark.png">
	<title>Orchestrator - {{.title}}</title>
	<script type="text/javascript" src="{{.prefix}}/js/jquery.min.js?v={{.assetVersion}}"></script>
	<script type="text/javascript" src="{{.prefix}}/js/jquery.cookie-1.4.1.min.js?v={{.assetVersion}}"></script>
	<script type="text/javascript" src="{{.prefix}}/js/corex.js?v={{.assetVersion}}"></script>
	<script type="text/javascript" src="{{.prefix}}/js/corex-jquery.js?v={{.assetVersion}}"></script>
	<script src="{{.prefix}}/js/md5.js?v={{.assetVersion}}"></script>
	<script src="{{.prefix}}/js/common.js?v={{.assetVersion}}"></script>
	<script src="{{.prefix}}/js/orchestrator.js?v={{.assetVersion}}"></script>
	<script src="{{.prefix}}/js/custom.js?v={{.assetVersion}}"></script>
	<link href="{{.prefix}}/bootstrap5/css/bootstrap.min.css?v={{.assetVersion}}" rel="stylesheet">
	<link href="{{.prefix}}/bootstrap-icons/font/bootstrap-icons.min.css?v={{.assetVersion}}" rel="stylesheet">
	<link href="{{.prefix}}/css/orchestrator.css?v={{.assetVersion}}" rel="stylesheet">
	<link href="{{.prefix}}/css/legacy-workspace.css?v={{.assetVersion}}" rel="stylesheet">
	<link href="{{.prefix}}/css/custom.css?v={{.assetVersion}}" rel="stylesheet">

	<style type="text/css">
		.ajaxLoader {
			visibility: hidden;
		}

	</style>

</head>

<body>

	<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
		<div class="container-fluid">
			<a class="navbar-brand orchestrator-brand" href="https://github.com/ProxySQL/orchestrator" target="_blank" rel="noopener noreferrer">orchestrator</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
		<div class="collapse navbar-collapse" id="navbarMain">
			<ul class="navbar-nav me-auto">
				<li class="nav-item">
					<a href="#" id="mainAjaxLoader" class="nav-link ajaxLoader"><img src="{{.prefix}}/images/ajax-loader.gif" /></a>
				</li>
				<li class="nav-item dropdown" data-nav-page="home">
					<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            Home
                        </a>
					<ul class="dropdown-menu">
						<li><a class="dropdown-item" href="{{.prefix}}/web/about">About</a></li>
						<li><a class="dropdown-item" href="https://proxysql.github.io/orchestrator/" target="_blank" rel="noopener noreferrer">Documentation</a></li>
						<li><a class="dropdown-item" href="https://github.com/ProxySQL/orchestrator/blob/master/docs/faq.md" target="_blank" rel="noopener noreferrer">FAQ</a></li>
						<li><hr class="dropdown-divider"></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/status">Status</a></li>
					</ul>
				</li>

				<li class="nav-item dropdown" data-nav-page="cluster">
					<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            Clusters
		                </a>
					<ul class="dropdown-menu" id="dropdown-clusters">
						<li><a class="dropdown-item" href="{{.prefix}}/web/clusters">Dashboard</a></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/clusters-analysis">Failure analysis</a></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/discover">Discover</a></li>
						<li><hr class="dropdown-divider"></li>
					</ul>
				</li>

				<li class="nav-item dropdown" data-nav-page="audit">
					<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            Audit
                        </a>
					<ul class="dropdown-menu">
						<li><a class="dropdown-item" href="{{.prefix}}/web/audit">Operations</a></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/audit-failure-detection">Failure detections</a></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/audit-recovery">Recoveries</a></li>
						{{if .agentsHttpActive}}
						<li><hr class="dropdown-divider"></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/agents">Agents</a></li>
						<li><a class="dropdown-item" href="{{.prefix}}/web/seeds">Seeds</a></li>
						{{end}}
					</ul>
				</li>

				<li class="nav-item" data-nav-page="search">
					<form class="d-flex" role="search" name="searchForm" action="{{.prefix}}/web/search">
						<input type="text" name="s" id="searchInput" class="form-control form-control-sm me-2" placeholder="Search" aria-label="Search instances">
						<button type="submit" class="btn btn-secondary btn-sm" aria-label="Submit search"><i class="bi bi-search" aria-hidden="true"></i></button>
					</form>
				</li>
			</ul>
			<ul class="navbar-nav align-items-lg-center" id="nav_operational_status" aria-label="Operational status">
				<li class="nav-item dropdown" data-nav-page="context" style="visibility: hidden;">
					<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
						<i class="bi bi-gear" aria-hidden="true"></i><span class="visually-hidden">Context</span>
					</a>
					<ul class="dropdown-menu" id="dropdown-context">
					</ul>
				</li>
				<li class="nav-item" data-nav-page="global-recoveries">
					<a id="global-recoveries-icon" class="nav-link" name="global-recoveries" href="#">
						<i class="bi d-none" aria-hidden="true"></i><span class="visually-hidden">Global recoveries</span>
					</a>
				</li>
				<li class="nav-item" data-nav-page="read-only" style="display: none;">
					<a class="nav-link" name="read-only" title="read only mode"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">Read-only mode</span></a>
				</li>
				<li class="nav-item" data-nav-page="user-id" style="display: none;">
					<a class="nav-link" name="user-id"></a>
				</li>
				<li class="nav-item" data-nav-page="refreshCountdown">
					<a href="#" id="refreshCountdown" class="nav-link small"></a>
				</li>
				<li class="nav-item" data-nav-page="problems">
					<div id="instance_problems">
						<div class="dropdown">
							<button type="button" id="instance_problems_button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Problems">
								<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span class="visually-hidden">Problems</span>
							</button>
							<ul class="dropdown-menu dropdown-menu-end" role="menu" aria-labelledby="instance_problems_button">
							</ul>
						</div>
					</div>
				</li>
			</ul>
		</div>
		</div>
	</nav>

	<div id="alerts_container"></div>
	<div class="container-fluid" id="main_container">

		{{yield}}

		<div class="modal fade" id="node_modal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						<h4 class="modal-title"></h4>
					</div>
					<div class="modal-body">

						<div class="card begin-downtime">
						  <div class="card-body">
								<form class="form-inline">
									<div class="form-group">
										<input type="text" class="form-control input-sm" id="beginDowntimeOwner" placeholder="owner name" />
										<input type="text" class="form-control input-sm" id="beginDowntimeReason" placeholder="reason" />
										<select class="form-control input-sm" id="beginDowntimeDuration">
											<option value="10m">10m</option>
											<option value="30m">30m</option>
											<option value="1h">1h</option>
											<option value="4h">4h</option>
											<option value="24h">24h</option>
											<option value="2d">2d</option>
											<option value="7d">7d</option>
										</select>
									</div>
									<button type="button" class="form-control btn btn-info pull-right" data-btn="begin-downtime">
										<i class="bi bi-pause-fill" aria-hidden="true"></i> Begin downtime
									</button>
								</form>
							</div>
						</div>
						<div class="card border-warning end-downtime">
							<div class="card-header"></div>
						  <div class="card-body">
							</div>
							<div class="card-footer">
								<button type="button" class="btn btn-secondary" data-btn="end-downtime">
									<i class="bi bi-play-fill" aria-hidden="true"></i> End downtime
								</button>
							</div>
						</div>

						<table id="modalDataAttributesTable" class="table">
							<div class="hidden-zone"></div>
						</table>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-success" data-btn="recover" title="Recover from failure"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Recover</button>
						<button type="button" class="btn alert-success" data-btn="refresh-instance" title="Refresh instance status now"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
						<button type="button" class="btn btn-danger" data-btn="stop-replica"><i class="bi bi-stop-fill" aria-hidden="true"></i> Stop replication</button>
						<button type="button" class="btn btn-success" data-btn="start-replica"><i class="bi bi-play-fill" aria-hidden="true"></i> Start replication</button>
						<button type="button" class="btn btn-warning" data-btn="restart-replica"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Restart replication</button>
						<button type="button" class="btn btn-danger" data-btn="detach-replica" title="Corrupt replica coordinates such that it fails to replicate. Reversible via reattach-replica"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Detach replica</button>
						<button type="button" class="btn btn-success" data-btn="reattach-replica" title="Restore replica coordinates corrupted by detach-replica"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Reattach replica</button>

						<button type="button" class="btn btn-danger" data-btn="skip-query" title="Skip a single query and resume replication">Skip query</button>
						<button type="button" class="btn btn-warning" data-btn="set-read-only"><i class="bi bi-eye" aria-hidden="true"></i> Set read-only</button>
						<button type="button" class="btn btn-warning" data-btn="set-writeable"><i class="bi bi-pencil" aria-hidden="true"></i> Set writeable</button>
						<button type="button" class="btn btn-warning" data-btn="reattach-replica-master-host" title="Reattach with detached master">
							Reattach</button>
						<button type="button" class="btn btn-danger" data-btn="reset-replica" title="Make this replica forget its master and stop replicating">Reset replica</button>
						<button type="button" class="btn btn-info" data-btn="take-siblings" title="Take siblings of this replica">Take siblings</button>
						<button type="button" class="btn btn-success" data-btn="enable-gtid"><i class="bi bi-diagram-3" aria-hidden="true"></i> Enable</button>
						<button type="button" class="btn btn-danger" data-btn="disable-gtid"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Disable</button>
						<div class="btn-group" data-btn-group="gtid-errant-fix">
							<button type="button" class="btn btn-danger" data-btn="gtid-errant-fix" data-grouped="true">Fix</button>
							<button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown">
								<span class="caret"></span> <span class="visually-hidden">Toggle Dropdown</span>
							</button>
							<ul class="dropdown-menu" role="menu">
								<li><a href="#" data-btn="gtid-errant-reset-master">Reset master</a></li>
								<li><a href="#" data-btn="gtid-errant-inject-empty">Inject empty transactions</a></li>
							</ul>
						</div>
						<button type="button" class="btn btn-info" data-btn="regroup-replicas" title="Pick candidate replica and have it take its siblings">Regroup replicas</button>
						<button type="button" class="btn alert-danger" data-btn="forget-instance" title="Make orchestrator forget this instance. Orchestrator may auto-find it again."><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Forget</button>
						<button type="button" class="btn btn-warning" data-btn="end-maintenance" title="End maintenance period now">End maintenance</button>
						<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
						<div class="btn-group" data-btn-group="move-equivalent">
							<button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">
								Safe revert to <span class="caret"></span> <span class="visually-hidden">Toggle Dropdown</span>
							</button>
							<ul class="dropdown-menu" role="menu">
							</ul>
						</div>
					</div>
				</div>
				<!-- /.modal-content -->
			</div>
			<!-- /.modal-dialog -->
		</div>
		<!-- /.modal -->

	</div>

	<script src="{{.prefix}}/bootstrap5/js/bootstrap.bundle.min.js?v={{.assetVersion}}"></script>
	<script src="{{.prefix}}/js/bootstrap-legacy-bridge.js?v={{.assetVersion}}"></script>
	<script>
		OrchestratorBootstrapBridge.init(document, window.jQuery, window.bootstrap);
	</script>
	<script type="text/javascript" src="{{.prefix}}/js/bootbox.min.js?v={{.assetVersion}}"></script>
	<script>
		function autoshowProblems() {
			return "{{.autoshow_problems}}";
		}

		function agentsHttpActive() {
			return "{{.agentsHttpActive}}";
		}

		function contextMenuVisible() {
			return "{{.contextMenuVisible}}";
		}

		function isAuthorizedForAction() {
			return "{{.authorizedForAction}}" == "true";
		}

		function getUserId() {
			return "{{.userId}}";
		}

		function webMessage() {
			return "{{.webMessage}}";
		}
	</script>
	<script src="{{.prefix}}/js/instance-problems.js?v={{.assetVersion}}"></script>
</body>

</html>
