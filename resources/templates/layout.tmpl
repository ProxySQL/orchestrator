	<div id="alerts_container"></div>
	<div class="container-fluid" id="main_container">
		<div class="float-end" id="instance_problems">
			<div class="dropdown float-end">
				<button type="button" id="instance_problems_button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Problems" aria-expanded="false">
					<span class="bi bi-exclamation-circle-fill"></span>
				</button>
				<ul class="dropdown-menu" role="menu" aria-labelledby="dLabel">
				</ul>
			</div>
		</div>

    {{block "content" .}}{{end}}

		<div class="modal fade" id="node_modal" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content">
					<div class="modal-header">
						<h4 class="modal-title"></h4>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">

						<div class="card begin-downtime">
						  <div class="card-body">
								<form class="form-inline">
									<div class="form-group d-flex flex-wrap gap-2 align-items-center">
										<input type="text" class="form-control form-control-sm" id="beginDowntimeOwner" placeholder="owner name" />
										<input type="text" class="form-control form-control-sm" id="beginDowntimeReason" placeholder="reason" />
										<select class="form-select form-select-sm" id="beginDowntimeDuration">
											<option value="10m">10m</option>
											<option value="30m">30m</option>
											<option value="1h">1h</option>
											<option value="4h">4h</option>
											<option value="24h">24h</option>
											<option value="2d">2d</option>
											<option value="7d">7d</option>
										</select>
										<button type="button" class="btn btn-info ms-auto" data-btn="begin-downtime">
											<span class="bi bi-volume-mute-fill"></span> Begin downtime
										</button>
									</div>
								</form>
							</div>
						</div>
						<div class="card border-warning end-downtime">
							<div class="card-header"></div>
						  <div class="card-body">
							</div>
							<div class="card-footer">
								<button type="button" class="btn btn-secondary" data-btn="end-downtime">
									<span class="bi bi-volume-up-fill"></span> End downtime
								</button>
							</div>
						</div>

						<table id="modalDataAttributesTable" class="table">
							<div class="hidden-zone"></div>
						</table>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-success" data-btn="recover" title="Recover from failure"><span class="bi bi-heart-fill"></span> Recover</button>
						<button type="button" class="btn alert-success" data-btn="refresh-instance" title="Refresh instance status now"><span class="bi bi-arrow-clockwise"></span> Refresh</button>
						<button type="button" class="btn btn-danger" data-btn="stop-replica"><span class="bi bi-stop-fill"></span> Stop replication</button>
						<button type="button" class="btn btn-success" data-btn="start-replica"><span class="bi bi-play-fill"></span> Start replication</button>
						<button type="button" class="btn btn-warning" data-btn="restart-replica"><span class="bi bi-arrow-repeat"></span> Restart replication</button>
						<button type="button" class="btn btn-danger" data-btn="detach-replica" title="Corrupt replica coordinates such that it fails to replicate. Reversible via reattach-replica"><span class="bi bi-x-circle-fill"></span> Detach replica</button>
						<button type="button" class="btn btn-success" data-btn="reattach-replica" title="Restore replica coordinates corrupted by detach-replica"><span class="bi bi-check-circle-fill"></span> Reattach replica</button>

						<button type="button" class="btn btn-danger" data-btn="skip-query" title="Skip a single query and resume replication">Skip query</button>
						<button type="button" class="btn btn-warning" data-btn="set-read-only"><span class="bi bi-eye-fill"></span> Set read-only</button>
						<button type="button" class="btn btn-warning" data-btn="set-writeable"><span class="bi bi-pencil-fill"></span> Set writeable</button>
						<button type="button" class="btn btn-warning" data-btn="reattach-replica-master-host" title="Reattach with detached master">Reattach</button>
						<button type="button" class="btn btn-danger" data-btn="reset-replica" title="Make this replica forget its master and stop replicating">Reset replica</button>
						<button type="button" class="btn btn-info" data-btn="take-siblings" title="Take siblings of this replica">Take siblings</button>
						<button type="button" class="btn btn-success" data-btn="enable-gtid"><span class="bi bi-globe"></span> Enable</button>
						<button type="button" class="btn btn-danger" data-btn="disable-gtid"><span class="bi bi-x-lg"></span> Disable</button>
						<div class="btn-group" data-btn-group="gtid-errant-fix">
							<button type="button" class="btn btn-danger" data-btn="gtid-errant-fix" data-grouped="true">Fix</button>
							<button type="button" class="btn btn-danger dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
								<span class="visually-hidden">Toggle Dropdown</span>
							</button>
							<ul class="dropdown-menu" role="menu">
								<li><a class="dropdown-item" href="#" data-btn="gtid-errant-reset-master">Reset master</a></li>
								<li><a class="dropdown-item" href="#" data-btn="gtid-errant-inject-empty">Inject empty transactions</a></li>
							</ul>
						</div>
						<button type="button" class="btn btn-info" data-btn="regroup-replicas" title="Pick candidate replica and have it take its siblings">Regroup replicas</button>
						<button type="button" class="btn alert-danger" data-btn="forget-instance" title="Make orchestrator forget this instance. Orchestrator may auto-find it again."><span class="bi bi-x-lg"></span> Forget</button>
						<button type="button" class="btn btn-warning" data-btn="end-maintenance" title="End maintenance period now">End maintenance</button>
						<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
						<div class="btn-group" data-btn-group="move-equivalent">
							<button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
								Safe revert to <span class="visually-hidden">Toggle Dropdown</span>
							</button>
							<ul class="dropdown-menu" role="menu">
							</ul>
						</div>
					</div>
				</div>
				<!-- /.modal-content -->
			</div>
			<!-- /.modal-dialog -->
		</div>
		<!-- /.modal -->

	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
	<!--
		jQuery-Bootstrap-5 bridge: Bootstrap 5 dropped the jQuery plugin wrappers
		that orchestrator's JS relies on. We re-add the small subset of jQuery
		plugins ($.fn.modal, $.fn.popover, $.fn.dropdown, $.fn.tooltip,
		$.fn.alert) on top of Bootstrap 5's native classes so the existing code
		keeps working. We also normalise legacy data-toggle/data-dismiss/data-target
		attributes onto Bootstrap 5's data-bs-* equivalents for any 3rd-party
		HTML that still uses them.

		The bridge installs in TWO passes: once synchronously here, and once
		on DOMContentLoaded. Bootstrap 5.3.x registers its own jQueryInterface
		via an onDOMContentLoaded callback fired during the same event — its
		registration would clobber ours if we only installed eagerly. The second
		pass guarantees we end up with the legacy-compatible signatures (e.g.
		`$(el).modal({})` opening the modal instead of just constructing it).
	-->
	<script>
	(function ($) {
		if (!$ || !window.bootstrap) return;

		function pluginFor(Ctor, opts) {
			opts = opts || {};
			return function (option, arg) {
				var ret;
				this.each(function () {
					if (opts.requireTitleOrContent) {
						var hasTitle = this.getAttribute("title") || this.getAttribute("data-bs-title");
						var hasContent = this.getAttribute("data-bs-content");
						if (!hasTitle && !hasContent) return;
					}
					var inst;
					var config = (option && typeof option === "object") ? option : undefined;
					try {
						inst = Ctor.getOrCreateInstance(this, config);
					} catch (err) {
						return;
					}
					if (typeof option === "string" && typeof inst[option] === "function") {
						var result = inst[option](arg);
						if (ret === undefined) ret = result;
					} else if (opts.defaultMethod && typeof inst[opts.defaultMethod] === "function") {
						// Legacy Bootstrap 3 behaviour: `$(el).modal()` / `$(el).modal({...})`
						// opens the modal. Replicate that for callers that pass options
						// or nothing.
						inst[opts.defaultMethod]();
					}
				});
				return ret === undefined ? this : ret;
			};
		}

		function install() {
			$.fn.modal    = pluginFor(bootstrap.Modal, { defaultMethod: "show" });
			$.fn.dropdown = pluginFor(bootstrap.Dropdown);
			$.fn.tooltip  = pluginFor(bootstrap.Tooltip, { requireTitleOrContent: true });
			$.fn.popover  = pluginFor(bootstrap.Popover, { requireTitleOrContent: true });

			$.fn.alert = function (option) {
				return this.each(function () {
					var el = this;
					if (option === "close") {
						bootstrap.Alert.getOrCreateInstance(el).close();
					} else {
						bootstrap.Alert.getOrCreateInstance(el);
					}
				});
			};
		}

		install();
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", install);
		} else {
			// DOM is already ready — Bootstrap's deferred registration has
			// either already fired or will fire in this turn of the event loop.
			// Re-install on the next tick to win the race.
			setTimeout(install, 0);
		}

		// Legacy attribute aliases. Some bootbox/legacy markup still emits the
		// Bootstrap 3 names; map them to the BS5 ones via a single delegated
		// listener so we don't have to find every occurrence.
		document.addEventListener("click", function (e) {
			var t = e.target.closest('[data-dismiss="modal"]');
			if (t) {
				var m = t.closest(".modal");
				if (m) bootstrap.Modal.getOrCreateInstance(m).hide();
			}
			var a = e.target.closest('[data-dismiss="alert"]');
			if (a) {
				var alertEl = a.closest(".alert");
				if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
			}
		});
	})(window.jQuery);
	</script>
