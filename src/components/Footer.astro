---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Orchestrator</h4>
        <p>MySQL High Availability and replication management. Maintained by <a href="https://proxysql.com">ProxySQL LLC</a>.</p>
      </div>
      <div class="footer-col">
        <h4>Links</h4>
        <ul>
          <li><a href={`${base}features/`}>Features</a></li>
          <li><a href={`${base}docs/`}>Documentation</a></li>
          <li><a href={`${base}support/`}>Support</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Community</h4>
        <ul>
          <li><a href="https://github.com/ProxySQL/orchestrator" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/ProxySQL/orchestrator/issues" target="_blank" rel="noopener noreferrer">Issues</a></li>
          <li><a href="https://github.com/ProxySQL/orchestrator/releases" target="_blank" rel="noopener noreferrer">Releases</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} <a href="https://proxysql.com">ProxySQL LLC</a>. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    padding: 3rem 0 1.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-col h4 {
    color: var(--color-text-inverse);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .footer-col p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col li {
    margin-bottom: 0.5rem;
  }

  .footer-col a {
    color: #94a3b8;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-text-inverse);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-primary-light);
    padding-top: 1.5rem;
    text-align: center;
  }

  .footer-bottom p {
    color: #64748b;
    font-size: 0.875rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
